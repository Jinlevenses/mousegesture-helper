<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.mousegesture-helper</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HELPER_PATH__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>MG_DRAG_THRESHOLD</key><string>50</string>
    <key>MG_HOLD_MS</key><string>300</string>
    <key>MG_HORIZONTAL_PROGRESS</key><string>1.6</string>
    <key>MG_VERTICAL_PROGRESS</key><string>1.0</string>
    <key>MG_HORIZONTAL_SIGN</key><string>-1</string>
    <key>MG_VERTICAL_SIGN</key><string>1</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__LOG_PATH__</string>
</dict>
</plist>
